# English localization for Javelin Expansion (internal mod ID: Spears).

Items: {
	GoldSpear: {
		DisplayName: Gilded Oath
		Tooltip:
			'''
			Tags ordinary enemies with Gold Curse
			Cursed enemies drop 25% to 100% bonus coins
			'''
	}

	NightsSpine: {
		DisplayName: Night's Spine
		Tooltip:
			'''
			Lodges in enemies for 4 seconds
			Maintains Shadowflame while lodged and briefly afterward
			'''
	}

	BloodSpine: {
		DisplayName: Crimson Vow
		Tooltip:
			'''
			Lodges in enemies for 4 seconds
			Maintains Ichor while lodged and briefly afterward
			'''
	}

	Hellrend: {
		DisplayName: Hellrend
		Tooltip:
			'''
			Throws three javelins that explode on contact
			Enemy hits inflict Hellfire
			'''
	}

	Mightpiercer: {
		DisplayName: Mightpiercer
		Tooltip: Homes through an enemy, overshoots it, then strikes again
	}

	GeminiGaze: {
		DisplayName: Gemini Gaze
		Tooltip:
			'''
			Launches paired homing javelins
			One inflicts Cursed Inferno; the other lodges and explodes
			'''
	}

	Frightsteel: {
		DisplayName: Frightsteel
		Tooltip: Launches a returning javelin, an inferno javelin, and a bleeding saw
	}

	FlowerSpike: {
		DisplayName: Venom Bloom
		Tooltip:
			'''
			Primary fire lodges and inflicts Venom
			Right-click poisons and briefly thorns eligible enemies in place
			'''
	}

	Tepoztopilli: {
		DisplayName: Tepoztopilli
		Tooltip:
			'''
			Explodes immediately on contact
			Enemy hits inflict On Fire!
			'''
	}

	MonarchsSpear: {
		DisplayName: Monarch's Ascension
		Tooltip:
			'''
			Five uses unleash the complete javelin lineage
			The sixth launches the Monarch's homing final strike
			'''
	}
}

Buffs: {
	GoldCurseDebuff: {
		DisplayName: Gold Curse
		Description: Drops bonus coins on death
	}

	ThornedDebuff: {
		DisplayName: Thorned
		Description: Unable to move or attack
	}
}

RecipeGroups.EvilSpear: Any evil-biome javelin

Projectiles: {
	ProgressionSpearProjectile.DisplayName: Thrown Javelin
	SpearBurstProjectile.DisplayName: Javelin Burst
}
