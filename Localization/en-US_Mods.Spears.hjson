# English localization for Spears.

Items: {
	GoldSpear: {
		DisplayName: Gold Spear
		Tooltip:
			'''
			Tags ordinary enemies with Gold Curse
			Cursed enemies drop 25% to 100% bonus coins
			'''
	}

	NightsSpine: {
		DisplayName: Post-Eater of Worlds Spear
		Tooltip:
			'''
			Lodges in enemies for 4 seconds
			Maintains Shadowflame while lodged and briefly afterward
			'''
	}

	BloodSpine: {
		DisplayName: Bloodspine
		Tooltip:
			'''
			Lodges in enemies for 4 seconds
			Maintains Ichor while lodged and briefly afterward
			'''
	}

	Hellrend: {
		DisplayName: Hellrend
		Tooltip:
			'''
			Throws three spears that explode on contact
			Enemy hits inflict Hellfire
			'''
	}

	Mightpiercer: {
		DisplayName: Mightpiercer
		Tooltip: Homes through an enemy, overshoots it, then strikes again
	}

	GeminiGaze: {
		DisplayName: Post-Twins Spear
		Tooltip:
			'''
			Launches paired homing spears
			One inflicts Cursed Inferno; the other lodges and explodes
			'''
	}

	Frightsteel: {
		DisplayName: Post-Skeletron Prime Spear
		Tooltip: Launches a returning spear, an inferno spear, and a bleeding saw
	}

	FlowerSpike: {
		DisplayName: FlowerSpike
		Tooltip:
			'''
			Primary fire lodges and inflicts Venom
			Right-click poisons and briefly thorns eligible enemies in place
			'''
	}

	Tepoztopilli: {
		DisplayName: Tepoztopilli
		Tooltip:
			'''
			Explodes immediately on contact
			Enemy hits inflict On Fire!
			'''
	}

	MonarchsSpear: {
		DisplayName: Monarch's Spear
		Tooltip:
			'''
			Five uses unleash the complete spear lineage
			The sixth launches the Monarch's homing final strike
			'''
	}
}

Buffs: {
	GoldCurseDebuff: {
		DisplayName: Gold Curse
		Description: Drops bonus coins on death
	}

	ThornedDebuff: {
		DisplayName: Thorned
		Description: Unable to move or attack
	}
}

RecipeGroups.EvilSpear: Any evil-biome spear

Projectiles: {
	ProgressionSpearProjectile.DisplayName: Progression Spear Projectile
	SpearBurstProjectile.DisplayName: Spear Burst Projectile
}
