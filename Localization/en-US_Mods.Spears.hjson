# English localization for Spears.

Items: {
	GoldSpear: {
		DisplayName: Gold Spear
		Tooltip:
			'''
			Trusty spear smeared with gold
			Lodges in enemies and may inflict Midas
			'''
	}

	NightsSpine: {
		DisplayName: Night's Spine
		Tooltip:
			'''
			The Corruption remembers every wound
			Detonations release a seeking shadow thorn that can stun ordinary enemies
			'''
	}

	BloodSpine: {
		DisplayName: Bloodspine
		Tooltip:
			'''
			It drinks before it blooms
			Detonations scatter a fan of blood needles
			'''
	}

	Hellrend: {
		DisplayName: Hellrend
		Tooltip:
			'''
			Three flames tear open the horizon
			Throws a central spear with two wide-arcing companions
			'''
	}

	Mightpiercer: {
		DisplayName: Mightpiercer
		Tooltip:
			'''
			Built from the Destroyer's broken spine
			Detonations arc electricity to nearby enemies
			'''
	}

	GeminiGaze: {
		DisplayName: Gemini Gaze
		Tooltip:
			'''
			Two eyes. One point
			Alternates between Retinazer beams and Spazmatism flames
			'''
	}

	Frightsteel: {
		DisplayName: Frightsteel
		Tooltip:
			'''
			The final machine learned fear
			Detonations launch four rotating Prime blades
			'''
	}

	FlowerSpike: {
		DisplayName: FlowerSpike
		Tooltip:
			'''
			Every wound takes root
			Poisons embedded enemies and blooms into seeking petals
			'''
	}

	Tepoztopilli: {
		DisplayName: Tepoztopilli
		Tooltip:
			'''
			The temple sun burns within
			Pierces armor and bursts into solar temple shards
			'''
	}

	MonarchsSpear: {
		DisplayName: Monarch's Spear
		Tooltip:
			'''
			Every spear in its lineage answers the call
			Cycles inherited spear effects and commands three orbiting weapons
			'''
	}
}

Buffs: {
	Stunned: {
		DisplayName: Stunned
		Description: Unable to move or act
	}

	TheKingsOfKings: {
		DisplayName: The Kings of Kings
		Description: Compelled to flee from the nearest player
	}
}

Conditions: {
	DownedEaterOfWorlds: Requires defeating the Eater of Worlds
	DownedBrainOfCthulhu: Requires defeating the Brain of Cthulhu
	DownedDestroyer: Requires defeating the Destroyer
	DownedTwins: Requires defeating the Twins
	DownedSkeletronPrime: Requires defeating Skeletron Prime
	DownedPlantera: Requires defeating Plantera
	DownedGolem: Requires defeating Golem
	DownedMoonLord: Requires defeating the Moon Lord
}

RecipeGroups.EvilSpear: Any evil-biome spear

Projectiles: {
	MonarchOrbitalProjectile.DisplayName: Monarch Orbital Projectile
	ProgressionSpearProjectile.DisplayName: Progression Spear Projectile
	SpearBurstProjectile.DisplayName: Spear Burst Projectile
	SpearSecondaryProjectile.DisplayName: Spear Secondary Projectile
}
